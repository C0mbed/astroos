<Window
    x:Class="AstroOS.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AstroOS.UI.Controls"
    Title="Dark Sky"
    MinWidth="1024"
    MinHeight="700">

    <!--
        Temporary scaffold layout: main content area above, Status Bar pinned at bottom.
        TODO(forge): Replace with full App Shell layout per pipeline/specs/app-shell-tech-spec.md
    -->
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <!-- Main content area — fills remaining height -->
            <RowDefinition Height="*"/>
            <!-- Status Bar — 40px fixed strip at the bottom -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Placeholder content — replaced by App Shell panes in a future build -->
        <TextBlock
            Grid.Row="0"
            Text="Dark Sky"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource TitleTextBlockStyle}" />

        <!-- Status Bar: Zone A (Safety), Zone B (Connection Widget), C + D (future) -->
        <controls:StatusBar
            x:Name="StatusBarControl"
            Grid.Row="1"/>

    </Grid>

</Window>
