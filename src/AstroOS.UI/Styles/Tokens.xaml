<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Dark Sky Design Token Layer — Brand System v1.0.0 + Amendment v1.1.0
        Translated from docs/design/tokens/ CSS custom properties.

        Usage: reference via {ThemeResource key-name}
        PLATFORM: WinUI3 — {ThemeResource} is used rather than {StaticResource}
        so that resources adapt automatically when system or app theme changes.
        The intent of "no hardcoded hex values" is fully satisfied: all colour
        references in controls go through a named token key.

        Token naming convention: mirrors CSS custom property names exactly so
        that diffs against the CSS source are trivial.
    -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- ═══════════════════════════════════════════════════════════ LIGHT -->
        <ResourceDictionary x:Key="Light">

            <!-- ── Background ── §6 Status Bar Contract v1.1.0 -->
            <SolidColorBrush x:Key="color-background-primary"   Color="#FFFFFF"/>
            <SolidColorBrush x:Key="color-background-secondary" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="color-background-tertiary"  Color="#EBEBEB"/>

            <!-- ── Border ── -->
            <SolidColorBrush x:Key="color-border-default" Color="#D1D1D1"/>
            <SolidColorBrush x:Key="color-border-subtle"  Color="#E5E5E5"/>

            <!-- ── Text ── -->
            <SolidColorBrush x:Key="color-text-primary"   Color="#0A0A0A"/>
            <SolidColorBrush x:Key="color-text-secondary" Color="#525252"/>
            <SolidColorBrush x:Key="color-text-tertiary"  Color="#A3A3A3"/>

            <!-- ── Interactive ── -->
            <SolidColorBrush x:Key="color-interactive-primary" Color="#2563EB"/>
            <SolidColorBrush x:Key="color-interactive-pressed" Color="#1D4ED8"/>

            <!-- ── Status: Success ── -->
            <SolidColorBrush x:Key="color-status-success" Color="#16A34A"/>

            <!-- ── Status: Warning ──
                 IMPORTANT: color-status-warning (#D97706) achieves 3.0:1 contrast
                 with white text — FAILS WCAG AA. Use ONLY for indicators (icons,
                 borders, badges). NEVER as a button background with white label.
                 See Brand System v1.1.0 for the accessible button variant below. -->
            <SolidColorBrush x:Key="color-status-warning" Color="#D97706"/>

            <!-- ── Status: Warning Accessible ── Brand System Amendment v1.1.0
                 color-status-warning-accessible: button backgrounds with white text
                 on amber — WCAG AA 4.7:1. Brand System v1.1.0.
                 Do NOT use color-status-warning (#D97706) as button bg with
                 white text — contrast is 3.0:1, fails WCAG AA. -->
            <SolidColorBrush x:Key="color-status-warning-accessible" Color="#B45309"/>

            <!-- ── Status: Error ── -->
            <SolidColorBrush x:Key="color-status-error"        Color="#DC2626"/>
            <SolidColorBrush x:Key="color-status-error-subtle" Color="#FEF2F2"/>

        </ResourceDictionary>

        <!-- ════════════════════════════════════════════════════════════ DARK -->
        <ResourceDictionary x:Key="Dark">

            <!-- ── Background ── -->
            <SolidColorBrush x:Key="color-background-primary"   Color="#0A0A0A"/>
            <SolidColorBrush x:Key="color-background-secondary" Color="#141414"/>
            <SolidColorBrush x:Key="color-background-tertiary"  Color="#1E1E1E"/>

            <!-- ── Border ── -->
            <SolidColorBrush x:Key="color-border-default" Color="#2E2E2E"/>
            <SolidColorBrush x:Key="color-border-subtle"  Color="#1E1E1E"/>

            <!-- ── Text ── -->
            <SolidColorBrush x:Key="color-text-primary"   Color="#F5F5F5"/>
            <SolidColorBrush x:Key="color-text-secondary" Color="#A3A3A3"/>
            <SolidColorBrush x:Key="color-text-tertiary"  Color="#525252"/>

            <!-- ── Interactive ── -->
            <SolidColorBrush x:Key="color-interactive-primary" Color="#3B82F6"/>
            <SolidColorBrush x:Key="color-interactive-pressed" Color="#2563EB"/>

            <!-- ── Status: Success ── -->
            <SolidColorBrush x:Key="color-status-success" Color="#22C55E"/>

            <!-- ── Status: Warning ──
                 IMPORTANT: color-status-warning (#F59E0B) on dark bg achieves
                 10.5:1 — AAA. Safe for indicator use. Still NEVER use as button
                 background with white text — use color-status-warning-accessible. -->
            <SolidColorBrush x:Key="color-status-warning" Color="#F59E0B"/>

            <!-- ── Status: Warning Accessible ── Brand System Amendment v1.1.0
                 color-status-warning-accessible: button backgrounds with white text
                 on amber — WCAG AA 4.7:1. Brand System v1.1.0.
                 Do NOT use color-status-warning (#D97706) as button bg with
                 white text — contrast is 3.0:1, fails WCAG AA.
                 Dark mode: maps to same value as color-status-warning (#F59E0B)
                 because dark-mode warning is already accessible (10.5:1 AAA). -->
            <SolidColorBrush x:Key="color-status-warning-accessible" Color="#F59E0B"/>

            <!-- ── Status: Error ── -->
            <SolidColorBrush x:Key="color-status-error"        Color="#EF4444"/>
            <SolidColorBrush x:Key="color-status-error-subtle" Color="#1F1111"/>

        </ResourceDictionary>

        <!-- ══════════════════════════════════════════════════ DEFAULT (= Dark) -->
        <!--  WinUI 3 resolves "Default" when system theme is undetermined.
              Dark Sky is an observatory app — default to dark. -->
        <ResourceDictionary x:Key="Default">

            <SolidColorBrush x:Key="color-background-primary"   Color="#0A0A0A"/>
            <SolidColorBrush x:Key="color-background-secondary" Color="#141414"/>
            <SolidColorBrush x:Key="color-background-tertiary"  Color="#1E1E1E"/>
            <SolidColorBrush x:Key="color-border-default" Color="#2E2E2E"/>
            <SolidColorBrush x:Key="color-border-subtle"  Color="#1E1E1E"/>
            <SolidColorBrush x:Key="color-text-primary"   Color="#F5F5F5"/>
            <SolidColorBrush x:Key="color-text-secondary" Color="#A3A3A3"/>
            <SolidColorBrush x:Key="color-text-tertiary"  Color="#525252"/>
            <SolidColorBrush x:Key="color-interactive-primary" Color="#3B82F6"/>
            <SolidColorBrush x:Key="color-interactive-pressed" Color="#2563EB"/>
            <SolidColorBrush x:Key="color-status-success" Color="#22C55E"/>
            <SolidColorBrush x:Key="color-status-warning" Color="#F59E0B"/>
            <!-- color-status-warning-accessible: button backgrounds with white text
                 on amber — WCAG AA 4.7:1. Brand System v1.1.0.
                 Do NOT use color-status-warning (#D97706) as button bg with
                 white text — contrast is 3.0:1, fails WCAG AA. -->
            <SolidColorBrush x:Key="color-status-warning-accessible" Color="#F59E0B"/>
            <SolidColorBrush x:Key="color-status-error"        Color="#EF4444"/>
            <SolidColorBrush x:Key="color-status-error-subtle" Color="#1F1111"/>

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!--
        ════════════════════════════════════════════════════ FONT FAMILIES
        Non-themed: font identity does not change between light and dark.
        Files must exist in Assets/Fonts/ and be included as Content items
        (SDK auto-includes Assets/**/* for WinUI3 builds).

        FONT FILE REQUIREMENT:
          Assets/Fonts/static/SpaceGrotesk-Bold.ttf — Space Grotesk 700 (static)
          Also in repo: SpaceGrotesk-VariableFont_wght.ttf + OFL.txt + README.txt
          Source: Google Fonts — OFL 1.1 — included in repo, licence confirmed.
    -->
    <FontFamily x:Key="font-brand-display">ms-appx:///Assets/Fonts/static/SpaceGrotesk-Bold.ttf#Space Grotesk</FontFamily>

</ResourceDictionary>
